# Coolify: set these in the resource Environment tab (no WEB_PORT).
# Local compose: copy to .env next to docker-compose.yml

NEXT_PUBLIC_SITE_URL=https://petroleu.com
CMS_AUTH_SECRET=replace-with-a-long-random-string
CMS_COOKIE_SECURE=true

# Optional
NEXT_PUBLIC_PMS_APP_URL=
NEXT_PUBLIC_DOCUMENTATION_URL=

# Local only (with docker-compose.local.yml)
# WEB_PORT=8080
