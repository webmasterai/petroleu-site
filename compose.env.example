# Copy to a file named .env next to docker-compose.yml, then change the secret.
# docker compose automatically reads .env for ${VAR} substitution.

# Host port. Site opens at http://localhost:8080
WEB_PORT=8080

# Public site URL (rebuild the image if you change this).
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Long random string. Admin login cookies are signed with this.
CMS_AUTH_SECRET=replace-with-a-long-random-string

# false for http, true for https
CMS_COOKIE_SECURE=false

# Optional links baked into the frontend. Leave empty if unused.
NEXT_PUBLIC_PMS_APP_URL=
NEXT_PUBLIC_DOCUMENTATION_URL=
