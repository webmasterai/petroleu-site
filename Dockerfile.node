# Single production image: Vite build + Node/Express CMS (MySQL)
# Laravel backend/ is NOT included — keep it until cutover is complete.

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.js eslint.config.js ./
COPY public ./public
COPY src ./src
# Same-origin /api/cms in production (Express serves API on same host)
ENV VITE_CMS_API_BASE_URL=/api/cms
RUN npm run build

WORKDIR /app/server
COPY server/package.json server/package-lock.json* ./
RUN npm ci --omit=dev

COPY server ./

FROM node:22-bookworm-slim
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3040
ENV SERVE_STATIC=true
ENV UPLOAD_DIR=uploads

COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server

WORKDIR /app/server
RUN mkdir -p uploads

EXPOSE 3040
CMD ["node", "src/index.js"]
