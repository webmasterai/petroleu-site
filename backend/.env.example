APP_NAME="Website CMS"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: sqlite. Production (Coolify): mysql — do not commit credentials.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SPA origin for CORS (required in production). Example: https://<NEW-WEBSITE-DOMAIN>
# Extra origins (comma-separated): CORS_ALLOWED_ORIGINS=https://www.example.com,https://staging.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# First CMS admin — used only by `php artisan cms:create-admin`
# Never commit real values. Leave empty in example files.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
CMS_ADMIN_NAME="CMS Admin"

# Optional inquiry notification recipients (comma-separated)
CMS_PK_INQUIRY_RECIPIENTS=
CMS_AF_INQUIRY_RECIPIENTS=
