NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=https://example.com
CMS_AUTH_SECRET=change-me-to-a-long-random-string
CMS_DATA_DIR=/app/storage/data
CMS_UPLOAD_DIR=/app/storage/uploads

# --- Google Reviews (server-only; never expose secrets to the browser) ---
# Set GOOGLE_REVIEWS_ENABLED=true when credentials are ready.
GOOGLE_REVIEWS_ENABLED=false
GOOGLE_REVIEWS_CACHE_TTL_SECONDS=10800
GOOGLE_REVIEWS_LISTING_URL=

# Preferred: Google Business Profile API (full review list + pagination)
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Fallback: Places API (rating + total count; only a small sample of review texts)
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
