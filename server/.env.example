# Node CMS API — copy to server/.env (never commit secrets)
PORT=3040
SERVE_STATIC=false
NODE_ENV=development

# Same MySQL database used by Laravel CMS (do not wipe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Public URL of this Node app (media absolute URLs). Leave empty for relative /uploads
APP_URL=

# Upload root (persistent volume in production)
UPLOAD_DIR=uploads

# Optional: also serve legacy Laravel public disk files
# LEGACY_STORAGE_DIR=../backend/storage/app/public
